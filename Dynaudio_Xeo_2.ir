Filetype: IR signals file
Version: 1
#
# Dynaudio Xeo 2 - generated from the manufacturer's published code table.
# Source: https://dynaudio.com/faq/where-do-i-find-the-hex-codes-for-the-xeo-remote-control
# Encoding follows Flipper-IRDB _Converted_/IR_Plus/D/DYNAUDIO/Xeo5.ir.
# NECext address bytes FF 00; command bytes reverse8(code XOR FF), reverse8(code).
# Shared buttons match the existing Xeo5 profile; Xeo 2-only buttons are untested.
# A/B/C and Status LED are parenthesized in the manufacturer's Xeo 2 table.
# No physical phone/speaker verification has been performed.
#
name: Power On
type: parsed
protocol: NECext
address: FF 00 00 00
command: FF 00 00 00
#
name: Power Off
type: parsed
protocol: NECext
address: FF 00 00 00
command: D7 28 00 00
